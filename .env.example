# Horizon 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# DeepSeek API Key (阿里云百炼 API Key)
DEEPSEEK_API_KEY=your-dashscope-api-key-here

# Telegram 配置（使用 Telethon 客户端）
# 1. Telegram API ID（从 https://my.telegram.org 获取）
TG_API_ID=12345678
# 2. Telegram API Hash（从 https://my.telegram.org 获取）
TG_API_HASH=your-telegram-api-hash
# 3. Session String（使用 telethon 获取：from telethon.sessions import StringSession）
TG_SESSION_STRING=your-session-string-here
# 4. Channel/Chat ID (格式: -100xxxxxxxxx)
TELEGRAM_CHAT_ID=-1001234567890